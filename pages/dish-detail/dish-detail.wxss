.detail {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 140rpx;
}
.detail-img {
  width: 100%;
  height: 520rpx;
  background: var(--color-paper);
}
.detail-body {
  margin: -40rpx 24rpx 0;
  position: relative;
}
.d-name {
  font-size: 38rpx;
  font-weight: 700;
}
.d-tags {
  margin-top: 10rpx;
}
.d-price {
  margin-top: 16rpx;
}
.d-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--color-sub);
  line-height: 1.7;
}
.spec-area {
  margin-top: 28rpx;
}
.note-area {
  margin-top: 24rpx;
}
.note-input {
  width: 100%;
  min-height: 120rpx;
  background: var(--color-paper);
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 26rpx;
}
.action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 110rpx;
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(140,90,60,0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  z-index: 40;
}
.qty-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.qty-label {
  font-size: 28rpx;
  color: var(--color-sub);
}
.add-btn {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 64rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
}
