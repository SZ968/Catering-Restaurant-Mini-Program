<view class="detail" wx:if="{{dish}}">
  <image class="detail-img" src="{{dish.image}}" mode="aspectFill" />

  <view class="detail-body card">
    <view class="d-name">{{dish.name}}</view>
    <view class="d-tags" wx:if="{{dish.tags.length}}">
      <text class="tag" wx:for="{{dish.tags}}" wx:key="*this" wx:for-item="t">{{t}}</text>
    </view>
    <view class="d-price price">
      <text class="price-symbol">¥</text><text class="price-num">{{priceText}}</text>
    </view>
    <view class="d-desc">{{dish.description}}</view>

    <view class="spec-area" wx:if="{{specs.length}}">
      <view class="section-title">规格</view>
      <spec-selector specs="{{specs}}" bind:change="onSpecChange" />
    </view>

    <view class="note-area">
      <view class="section-title">口味备注</view>
      <textarea
        class="note-input"
        placeholder="如：少辣、不要香菜（选填）"
        value="{{note}}"
        bindinput="onNote"
        maxlength="50"
      />
    </view>
  </view>

  <view class="action-bar safe-bottom">
    <view class="qty-box">
      <text class="qty-label">数量</text>
      <stepper value="{{quantity}}" min="1" max="99" bind:change="onQtyChange" />
    </view>
    <view class="add-btn" bindtap="onAdd">加入购物车</view>
  </view>
</view>
