.cart-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}
.cart-head {
  margin-bottom: 20rpx;
}
.cart-title {
  font-size: 34rpx;
  font-weight: 700;
}
.cart-clear {
  font-size: 26rpx;
  color: var(--color-sub);
}
.empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.empty-ico {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: var(--color-paper);
  color: var(--color-brown);
  font-size: 48rpx;
  display: flex; align-items: center; justify-content: center;
}
.empty-text {
  font-size: 26rpx;
  color: var(--color-sub);
  text-align: center;
  padding: 0 60rpx;
}
.empty-btn {
  margin-top: 8rpx;
  padding: 0 48rpx;
}
.cart-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.ci-img {
  width: 160rpx; height: 160rpx;
  border-radius: 12rpx;
  background: var(--color-paper);
  flex-shrink: 0;
}
.ci-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.ci-name {
  font-size: 30rpx;
  font-weight: 700;
}
.ci-spec {
  font-size: 22rpx;
  color: var(--color-primary);
  margin-top: 6rpx;
}
.ci-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-sub);
  background: var(--color-paper);
  border-radius: 10rpx;
  padding: 8rpx 14rpx;
}
.ci-bottom {
  margin-top: 12rpx;
}
.ci-ops {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ci-del {
  font-size: 24rpx;
  color: var(--color-sub);
}
.checkout-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 104rpx;
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(140,90,60,0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  z-index: 40;
}
.cb-total {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.cb-label {
  font-size: 26rpx;
  color: var(--color-sub);
}
.cb-btn {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 72rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
}
.bottom-space {
  height: 120rpx;
}
