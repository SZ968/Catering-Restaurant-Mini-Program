<view class="menu-page">
  <category-tabs
    categories="{{categories}}"
    activeId="{{activeId}}"
    bind:change="onCategoryChange"
  />

  <scroll-view scroll-y="true" class="dish-list">
    <view class="count-hint" wx:if="{{categories.length}}">
      当前分类共 {{dishCountInCategory}} 道菜品
    </view>

    <view class="dish-wrap" wx:for="{{dishes}}" wx:key="_id">
      <dish-card dish="{{item}}" />
    </view>

    <view class="empty-state" wx:if="{{categories.length && !dishes.length}}">
      <text class="empty-icon">🍽️</text>
      <text class="empty-title">该分类暂无菜品</text>
      <text class="empty-desc">当前分类共 0 道菜，试试其他分类</text>
    </view>

    <view class="list-bottom-safe"></view>
  </scroll-view>

  <cart-bar
    wx:if="{{cartCount > 0}}"
    total="{{cartTotal}}"
    count="{{cartCount}}"
    disabled="{{!isOpen}}"
    disabledText="休息中"
    bind:checkout="onCheckout"
  />
  <view class="bottom-space" wx:if="{{cartCount > 0}}"></view>
</view>
