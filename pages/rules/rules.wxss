.rules-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  box-sizing: border-box;
}

.rules-header {
  background: linear-gradient(135deg, var(--color-primary), #c9531f);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(232, 112, 58, 0.25);
}
.shop-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.rules-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.reg-block {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(140, 90, 60, 0.08);
}
.reg-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  padding-bottom: 18rpx;
  margin-bottom: 14rpx;
  border-bottom: 2rpx solid var(--color-paper);
}
.reg-para {
  font-size: 27rpx;
  line-height: 1.75;
  color: #4a4038;
  margin-bottom: 14rpx;
  text-align: justify;
}
.reg-para:last-child {
  margin-bottom: 0;
}

.list-bottom-safe {
  height: 40rpx;
}
