.map-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}
.map-view {
  width: 100%;
  height: 60vh;
}
.map-info {
  margin: -40rpx 24rpx 0;
  position: relative;
  border-radius: 22rpx;
}
.mi-name {
  font-size: 34rpx;
  font-weight: 700;
}
.mi-addr {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-sub);
}
.mi-phones {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.mi-phone {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--color-paper);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}
.mi-ico {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.mi-num {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.mi-tag {
  font-size: 24rpx;
  color: var(--color-primary);
}
.nav-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
}
