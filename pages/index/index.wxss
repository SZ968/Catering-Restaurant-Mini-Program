/* ============ 三屏外壳 ============ */
.app {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

/* 顶部三屏切换指示 */
.top-tabs {
  position: fixed;
  left: 0; right: 0; top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}
/* 定宽居中：三列等宽 => 首页精确居中，列窄 => 间隙小 */
.tab-row {
  display: flex;
  align-items: center;
  width: 460rpx;
}
.tab {
  position: relative;
  flex: 1;
  text-align: center;
  white-space: nowrap;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  transition: color 0.2s ease, transform 0.2s ease;
}
.tab.on {
  font-weight: 700;
  transform: scale(1.06);
}
.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -6rpx;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  border-radius: 999rpx;
}

/* 第 1 屏（首页）：指示条浮在 Hero 深色区上，白字 */
.over-hero .top-tabs { background: transparent; }
.over-hero .tab { color: rgba(255, 255, 255, 0.7); }
.over-hero .tab.on { color: #fff; }
.over-hero .tab.on::after { background: #fff; }

/* 第 2/3 屏：指示条带底色，深字 */
.over-page .top-tabs {
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-line);
}
.over-page .tab { color: var(--color-sub); }
.over-page .tab.on { color: var(--color-primary); }
.over-page .tab.on::after { background: var(--color-primary); }

.pager {
  width: 100%;
  height: 100vh;
}
.panel {
  height: 100%;
  box-sizing: border-box;
}
.panel-spacer {
  width: 100%;
}
.bottom-space {
  height: 120rpx;
}

/* ============ Hero ============ */
.home {
  min-height: 100vh;
  background: radial-gradient(135% 50% at 50% 0%, #fff7ec 0%, var(--color-bg) 48%);
  padding-bottom: 40rpx;
}
.hero {
  position: relative;
  width: 100%;
  height: 620rpx;
  overflow: hidden;
  border-bottom-left-radius: 52rpx;
  border-bottom-right-radius: 52rpx;
  box-shadow: 0 20rpx 48rpx rgba(60, 30, 15, 0.22);
}
.hero-swiper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.hero-img {
  width: 100%;
  height: 100%;
}
.hero-fallback {
  background: linear-gradient(160deg, #C2392B, #8C5A3C);
}
.status-bar-filler {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 3;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0.08) 70%, rgba(0, 0, 0, 0) 100%);
  pointer-events: none;
}
.hero-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 1;
  background:
    linear-gradient(180deg,
      rgba(30, 18, 12, 0.18) 0%,
      rgba(30, 18, 12, 0.02) 30%,
      rgba(30, 18, 12, 0.42) 72%,
      rgba(20, 12, 8, 0.72) 100%);
}
.hero-grad-bottom {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(251, 246, 239, 0) 0%, rgba(251, 246, 239, 0.9) 100%);
  pointer-events: none;
}
.brand-box {
  position: absolute;
  left: 0; right: 0;
  top: 46%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 48rpx;
}
.brand-kicker {
  font-size: 22rpx;
  letter-spacing: 10rpx;
  color: rgba(255, 233, 214, 0.9);
  margin-bottom: 22rpx;
  opacity: 0;
  animation: fadeUp 0.7s 0.12s ease-out forwards;
}
.brand-name {
  font-size: 96rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 12rpx;
  line-height: 1.1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.22), 0 12rpx 36rpx rgba(0, 0, 0, 0.5);
}
.brand-divider {
  width: 72rpx;
  height: 2rpx;
  margin: 24rpx 0;
  background: linear-gradient(90deg, transparent, rgba(230, 186, 92, 0.95), transparent);
  opacity: 0;
  animation: fadeUp 0.7s 0.22s ease-out forwards;
}
.brand-slogan {
  font-size: 28rpx;
  font-weight: 300;
  letter-spacing: 6rpx;
  color: rgba(255, 233, 214, 0.95);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
  opacity: 0;
  animation: fadeUp 0.7s 0.32s ease-out forwards;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============ 区块标题 ============ */
.section-head {
  padding: 40rpx 28rpx 4rpx;
}

/* ============ 核心服务入口 ============ */
.svc-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 8rpx 24rpx 0;
}
.svc-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(62, 39, 35, 0.05), 0 16rpx 38rpx rgba(140, 90, 60, 0.10);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.svc-card:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 2rpx 8rpx rgba(62, 39, 35, 0.06), 0 8rpx 22rpx rgba(140, 90, 60, 0.08);
}
.svc-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.3), 0 8rpx 18rpx rgba(140, 90, 60, 0.22);
}
.svc-loc   { background: linear-gradient(140deg, #3F5A4B, #2c4034); }
.svc-rule  { background: linear-gradient(140deg, #8C5A3C, #6b4226); }
.svc-phone { background: linear-gradient(140deg, #E65C2A, #C2392B); }
.svc-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.svc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.svc-desc {
  font-size: 22rpx;
  color: var(--color-sub);
  letter-spacing: 1rpx;
}
.svc-arrow {
  color: var(--color-sub);
  font-size: 36rpx;
}

/* ============ 地址条 ============ */
.addr-bar {
  margin: 22rpx 24rpx 8rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(62, 39, 35, 0.05), 0 14rpx 30rpx rgba(140, 90, 60, 0.08);
}
.addr-ico {
  width: 46rpx; height: 46rpx;
  border-radius: 50%;
  background: rgba(230, 92, 42, 0.12);
  color: var(--color-primary);
  font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.addr-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}
.addr-arrow {
  color: var(--color-sub);
  font-size: 32rpx;
}

/* ============ 公告区 ============ */
.ann-card {
  margin: 8rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(62, 39, 35, 0.05), 0 16rpx 38rpx rgba(140, 90, 60, 0.10);
}
.ann-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.ann-item:last-child {
  border-bottom: none;
}
.ann-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.ann-pin {
  font-size: 20rpx;
  color: #8a5a12;
  background: linear-gradient(135deg, #f6d99b, #e9b85a);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.ann-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}
.ann-content {
  display: block;
  font-size: 24rpx;
  color: var(--color-sub);
  line-height: 1.7;
}
.ann-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}
.ann-empty-ico { font-size: 48rpx; margin-bottom: 12rpx; }
.ann-empty-text { font-size: 24rpx; color: var(--color-sub); }

/* ============ 商家管理入口 ============ */
.merchant-entry {
  margin: 30rpx auto 4rpx;
  width: fit-content;
  padding: 10rpx 30rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(120, 60, 30, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}
.merchant-entry:active {
  background: rgba(120, 60, 30, 0.45);
}

/* ============ 模块动态入场（交错淡入上滑） ============ */
.module-enter {
  animation: modFadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  will-change: transform, opacity;
}
@keyframes modFadeUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* 用户关闭系统动画时回退为直接显示，避免内容不可见 */
@media (prefers-reduced-motion: reduce) {
  .module-enter {
    animation: none;
  }
}
