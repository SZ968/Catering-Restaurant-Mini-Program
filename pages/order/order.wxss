.order-detail {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: 160rpx;
}
.od-hero {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  border-radius: 18rpx;
  padding: 40rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.od-hero.cancel {
  background: #9e9e9e;
}
.od-status {
  font-size: 44rpx;
  font-weight: 700;
}
.od-type {
  font-size: 26rpx;
  opacity: 0.9;
}
.info-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.info-row:last-child { border-bottom: none; }
.ir-label {
  width: 150rpx;
  color: var(--color-sub);
  flex-shrink: 0;
}
.ir-value {
  flex: 1;
  color: var(--color-text);
}
.od-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.od-item:last-child { border-bottom: none; }
.od-name { flex: 1; min-width: 0; }
.od-spec { font-size: 22rpx; color: var(--color-primary); margin: 0 12rpx; }
.od-qty { color: var(--color-sub); margin: 0 16rpx; }
.od-price { font-weight: 600; }
.od-total {
  text-align: right;
  margin-top: 16rpx;
  font-size: 28rpx;
}
.od-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 110rpx;
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(140,90,60,0.12);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 28rpx;
  z-index: 40;
}
.od-call {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: 28rpx;
}
.od-pay {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.od-offline-tip {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #FBE9DF;
  color: var(--color-primary);
  border-radius: 999rpx;
  font-size: 28rpx;
}
.bottom-space { height: 120rpx; }
