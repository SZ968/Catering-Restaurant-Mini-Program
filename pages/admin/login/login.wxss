.admin-login {
  min-height: 100vh;
  background: linear-gradient(160deg, #C2392B, #8C5A3C);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 0;
}
.al-logo {
  font-size: 72rpx;
  color: #fff;
  letter-spacing: 8rpx;
}
.al-sub {
  margin-top: 12rpx;
  color: #ffe9d6;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
.al-card {
  margin-top: 80rpx;
  width: 100%;
  background: rgba(255,255,255,0.96);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.al-tip {
  font-size: 28rpx;
  color: var(--color-text);
}
.al-openid {
  font-size: 22rpx;
  color: var(--color-sub);
  word-break: break-all;
  text-align: center;
}
.al-copy {
  font-size: 24rpx;
  color: #C2392B;
  border: 1rpx solid rgba(194, 57, 43, 0.5);
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
}
.al-btn {
  margin-top: 10rpx;
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 56rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
}
.al-note {
  font-size: 22rpx;
  color: var(--color-sub);
  text-align: center;
  line-height: 1.6;
}
