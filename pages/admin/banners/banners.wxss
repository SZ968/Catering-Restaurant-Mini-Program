.banners {
  padding: 28rpx 24rpx 60rpx;
  min-height: 100vh;
  background: #f7f2ea;
}
.b-header { margin-bottom: 24rpx; }
.b-title { font-size: 40rpx; color: #3E2723; display: block; }
.b-sub { font-size: 22rpx; color: #8c7a6b; }

.upload-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.b-input {
  flex: 1;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 14rpx rgba(140, 90, 60, 0.08);
}
.b-upload {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 26rpx;
  border-radius: 14rpx;
  padding: 0 28rpx;
  line-height: 2.6;
  margin: 0;
}
.b-upload::after { border: none; }

.b-list { display: flex; flex-direction: column; gap: 16rpx; }
.b-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(140, 90, 60, 0.08);
}
.b-thumb {
  width: 120rpx; height: 90rpx;
  border-radius: 12rpx;
  background: #efe6da;
  flex-shrink: 0;
}
.b-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.b-name { font-size: 26rpx; color: #3E2723; }
.b-state { font-size: 20rpx; }
.b-state.on { color: #2f8a4e; }
.b-state.off { color: #b08968; }
.b-ops { display: flex; flex-direction: column; gap: 8rpx; align-items: flex-end; }
.b-op {
  font-size: 22rpx;
  color: #6b4a35;
  background: #f3e9dc;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.b-op.danger { color: #fff; background: #c2392b; }

.b-tip {
  text-align: center;
  color: #a08b78;
  font-size: 24rpx;
  padding: 40rpx 0;
}
