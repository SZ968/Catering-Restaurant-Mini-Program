.admin-admins {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 40rpx 28rpx 60rpx;
  box-sizing: border-box;
}
.aa-header {
  margin-bottom: 28rpx;
}
.aa-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
}
.aa-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-sub);
}
.aa-section {
  margin-bottom: 32rpx;
}
.aa-sec-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 14rpx;
}
.aa-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(62, 39, 35, 0.05), 0 14rpx 30rpx rgba(140, 90, 60, 0.08);
}
.aa-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.aa-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.aa-role {
  font-size: 20rpx;
  color: #8a5a12;
  background: linear-gradient(135deg, #f6d99b, #e9b85a);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
  font-weight: 600;
}
.aa-openid {
  font-size: 20rpx;
  color: var(--color-sub);
  word-break: break-all;
}
.aa-actions {
  flex-shrink: 0;
  margin-left: 20rpx;
}
.aa-btn {
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.aa-pass {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
}
.aa-del {
  background: rgba(194, 57, 43, 0.10);
  color: #C2392B;
  border: 1rpx solid rgba(194, 57, 43, 0.3);
}
.aa-empty {
  font-size: 24rpx;
  color: var(--color-sub);
  text-align: center;
  padding: 30rpx 0;
}
.aa-tip {
  font-size: 22rpx;
  color: var(--color-sub);
  line-height: 1.6;
  margin-top: 20rpx;
}
