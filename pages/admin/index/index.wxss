.admin-index {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 32rpx 24rpx 60rpx;
}
.ai-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 28rpx;
}
.ai-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}
.ai-sub {
  font-size: 24rpx;
  color: var(--color-sub);
}
.ai-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(140,90,60,0.08);
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-sub);
}
.ai-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.ai-item {
  width: calc((100% - 40rpx) / 3);
  background: #fff;
  border-radius: 18rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 6rpx 20rpx rgba(140,90,60,0.08);
}
.ai-ico {
  width: 76rpx; height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
}
.ai-label {
  font-size: 26rpx;
  color: var(--color-text);
}
