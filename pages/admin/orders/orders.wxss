.admin-orders {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 20rpx 24rpx 40rpx;
}
.filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.ft-item {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--color-sub);
  font-size: 26rpx;
}
.ft-item.active {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-weight: 600;
}
.ao-card { margin-bottom: 20rpx; padding: 24rpx; }
.ao-head { margin-bottom: 10rpx; }
.ao-no { font-size: 28rpx; font-weight: 700; max-width: 60%; }
.ao-status { font-size: 24rpx; color: var(--color-primary); }
.ao-items { font-size: 24rpx; color: var(--color-sub); margin-bottom: 10rpx; }
.ao-foot { border-top: 1rpx solid var(--color-line); padding-top: 12rpx; }
.ao-time { font-size: 22rpx; color: #aaa; }
.ao-total { font-size: 28rpx; font-weight: 700; color: var(--color-primary-dark); }
.ao-ops {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}
.ao-op {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  color: #fff;
}
.ao-op.paid { background: #E6A23C; }
.ao-op.prep { background: #3F5A4B; }
.ao-op.done { background: #E65C2A; }
.ao-op.cancel { background: #9e9e9e; }
.empty { margin-top: 160rpx; text-align: center; }
.empty-text { font-size: 26rpx; color: var(--color-sub); }
