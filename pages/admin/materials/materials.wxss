.admin-materials {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}
.am-head {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.am-form { margin-bottom: 24rpx; }
.af-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.af-label { width: 110rpx; font-size: 26rpx; color: var(--color-sub); flex-shrink: 0; }
.af-input {
  flex: 1;
  background: var(--color-paper);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.af-picker { flex: 1; }
.am-upload {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
}
.am-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.am-cell {
  width: calc((100% - 40rpx) / 3);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(140,90,60,0.08);
}
.am-img {
  width: 100%;
  height: 220rpx;
  background: var(--color-paper);
}
.am-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
}
.am-del {
  font-size: 24rpx;
  color: #c0392b;
}
