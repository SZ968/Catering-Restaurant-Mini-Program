.ann {
  padding: 28rpx 24rpx 60rpx;
  min-height: 100vh;
  background: #f7f2ea;
}
.a-header { margin-bottom: 22rpx; }
.a-title { font-size: 40rpx; color: #3E2723; display: block; }
.a-sub { font-size: 22rpx; color: #8c7a6b; }

.a-form {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 90, 60, 0.08);
  margin-bottom: 28rpx;
}
.a-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0e7da;
}
.a-row.col { flex-direction: column; align-items: stretch; }
.a-label { width: 90rpx; font-size: 26rpx; color: #6b4a35; flex-shrink: 0; }
.a-input {
  flex: 1;
  font-size: 26rpx;
  padding: 8rpx 4rpx;
}
.a-textarea {
  width: 100%;
  height: 180rpx;
  font-size: 26rpx;
  padding: 12rpx;
  background: #faf5ee;
  border-radius: 12rpx;
  margin-top: 8rpx;
}
.a-actions { display: flex; gap: 18rpx; margin-top: 22rpx; }
.a-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 14rpx;
  line-height: 2.6;
  margin: 0;
}
.a-btn::after { border: none; }
.a-btn.primary { background: linear-gradient(135deg, #E65C2A, #C2392B); color: #fff; }
.a-btn.ghost { background: #f3e9dc; color: #6b4a35; }

.a-list { display: flex; flex-direction: column; gap: 16rpx; }
.a-item {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx 22rpx 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(140, 90, 60, 0.08);
}
.a-item-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.a-pin {
  font-size: 20rpx; color: #8a5a12;
  background: linear-gradient(135deg, #f6d99b, #e9b85a);
  padding: 2rpx 12rpx; border-radius: 8rpx; font-weight: 600;
}
.a-item-title { font-size: 28rpx; font-weight: 600; color: #3E2723; flex: 1; }
.a-badge { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx; }
.a-badge.on { color: #2f8a4e; background: rgba(47, 138, 78, 0.12); }
.a-badge.off { color: #b08968; background: rgba(176, 137, 104, 0.14); }
.a-item-content {
  display: block; font-size: 24rpx; color: #6b5b4d; line-height: 1.7;
  margin-bottom: 14rpx;
}
.a-item-ops { display: flex; gap: 28rpx; border-top: 1rpx solid #f0e7da; padding-top: 14rpx; }
.a-op { font-size: 24rpx; color: #6b4a35; }
.a-op.danger { color: #c2392b; }

.a-empty { text-align: center; color: #a08b78; font-size: 24rpx; padding: 40rpx 0; }
