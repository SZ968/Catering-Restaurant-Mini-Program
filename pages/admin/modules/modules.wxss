.mod-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 32rpx 24rpx 60rpx;
}
.mp-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}
.mp-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}
.mp-sub {
  font-size: 22rpx;
  color: var(--color-sub);
  margin-top: 8rpx;
}
.mod-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.mod-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(62, 39, 35, 0.05), 0 14rpx 30rpx rgba(140, 90, 60, 0.08);
}
.mod-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.mod-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mod-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.mod-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.mod-type {
  font-size: 20rpx;
  color: var(--color-sub);
}
.mod-ops {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-line);
}
.op-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8a4a2c;
  background: rgba(194, 57, 43, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 0;
}
.op-btn.ghost {
  color: var(--color-sub);
  background: rgba(120, 90, 60, 0.06);
}
.op-btn.disabled {
  opacity: 0.35;
}
.mp-tip {
  font-size: 22rpx;
  color: var(--color-sub);
  text-align: center;
  margin-top: 28rpx;
  line-height: 1.6;
}
