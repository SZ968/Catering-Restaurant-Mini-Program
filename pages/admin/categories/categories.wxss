.admin-cats {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}
.ac-head { margin-bottom: 20rpx; }
.ac-title { font-size: 34rpx; font-weight: 700; }
.ac-add {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}
.ac-form { margin-bottom: 24rpx; }
.af-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.af-label { width: 110rpx; font-size: 26rpx; color: var(--color-sub); flex-shrink: 0; }
.af-input {
  flex: 1;
  background: var(--color-paper);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.af-submit {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
}
.cat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 18rpx;
}
.cr-name { font-size: 30rpx; font-weight: 700; }
.cr-sort { font-size: 22rpx; color: var(--color-sub); margin-left: 16rpx; }
.cr-ops { display: flex; align-items: center; gap: 24rpx; }
.cr-del { font-size: 24rpx; color: #c0392b; }
