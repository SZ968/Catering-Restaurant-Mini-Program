.feed {
  padding: 8rpx 24rpx 24rpx;
}
.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx 16rpx;
}
.feed-title {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}
.feed-post {
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(194, 57, 43, 0.28);
}
.feed-post:active { opacity: 0.9; }

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.moment {
  border-radius: 24rpx;
  padding: 20rpx;
  position: relative;
}
.moment-imgs {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.moment-img {
  width: 100%;
  background: #f0ece4;
  border-radius: 16rpx;
}
.moment-note {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text);
}
.moment-del {
  margin-top: 12rpx;
  align-self: flex-end;
  font-size: 22rpx;
  color: var(--color-sub);
  border: 1rpx solid var(--color-line);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}
.moment-del:active { background: var(--color-paper); }

.feed-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.fe-ico { font-size: 60rpx; margin-bottom: 16rpx; }
.fe-text { font-size: 24rpx; color: var(--color-sub); }

/* —— 发布弹层 —— */
.composer-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(20, 12, 8, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.composer {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
}
.composer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
}
.uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #f0ece4;
}
.thumb image { width: 100%; height: 100%; }
.thumb-del {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.thumb-add {
  display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed var(--color-line);
  color: var(--color-sub);
  font-size: 56rpx;
}
.composer-note {
  width: 100%;
  min-height: 120rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
  padding: 18rpx;
  font-size: 26rpx;
}
.composer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.cbtn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.cbtn.ghost {
  background: var(--color-paper);
  color: var(--color-text);
}
.cbtn.primary {
  background: linear-gradient(135deg, #E65C2A, #C2392B);
  color: #fff;
}
.cbtn.primary:active { opacity: 0.9; }
