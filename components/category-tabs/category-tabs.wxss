.cat-tabs {
  width: 100%;
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid var(--color-line);
}
.cat-track {
  display: inline-flex;
  padding: 0 16rpx;
}
.cat-item {
  display: inline-block;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--color-sub);
  position: relative;
}
.cat-item.active {
  color: var(--color-primary);
  font-weight: 700;
}
.cat-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
}
.cat-hint {
  text-align: center;
  padding: 8rpx 0 12rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-line);
}
.cat-hint-text {
  font-size: 22rpx;
  color: var(--color-sub);
}
